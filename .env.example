# Copy this file to .env and adjust values if needed.
# .env is gitignored and should NEVER be committed.

# ─── App URL ───────────────────────────────────────────────────────────────────
BASE_URL=https://www.saucedemo.com

# ─── Login Credentials ──────────────────────────────────────────────────────────
# Sauce Demo publishes these test accounts publicly on the login page itself:
# standard_user, locked_out_user, problem_user, performance_glitch_user,
# error_user, visual_user — all share the same password below.
USERNAME=standard_user
PASSWORD=secret_sauce

# ─── Slack Reporter (optional — only needed for CI reporting) ────────────────
# Bot token from https://api.slack.com/apps → OAuth & Permissions
#SLACK_BOT_TOKEN=xoxb-your-bot-token

# Channel ID (right-click channel in Slack → Copy link → last segment)
#SLACK_CHANNEL_ID=your-channel-id

# ─── Browser Options ─────────────────────────────────────────────────────────
# Set to "false" to run tests with visible browser (useful for local debugging)
HEADLESS=false

# ─── CI / Runner (optional) ───────────────────────────────────────────────────
# CI=true
# CIRCLE_BUILD_URL=
# CIRCLE_BUILD_NUM=
